# Copy to .env (gitignored) and fill in. Never commit real values.
# Transport Victoria Open Data Portal key: https://opendata.transport.vic.gov.au/user/login
TVOD_API_KEY=
# Hugging Face token with write access to the dataset repo only
HF_TOKEN=
# Dataset repo that receives snapshots (leave blank to keep snapshots local under data/)
HF_DATASET_REPO=Karry001/movemelbourne-gtfsr
